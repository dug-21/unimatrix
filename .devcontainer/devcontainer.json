{
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "TMPDIR": "/var/tmp"
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/python:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "dockerDashComposeVersion": "v2",
      "moby": false
    }
  },
  "postCreateCommand": "curl -fsSL https://claude.ai/install.sh | bash && echo 'alias dsp=\"claude --dangerously-skip-permissions\"' >> ~/.bashrc && echo 'alias dspc=\"claude --dangerously-skip-permissions -c\"' >> ~/.bashrc",
  "postStartCommand": ".devcontainer/setup-docker.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb"
      ]
    }
  }
}
