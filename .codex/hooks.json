{
  "description": "Unimatrix lifecycle observation for Codex. --provider codex-cli is required for correct source_domain attribution.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^context_cycle$|^mcp__unimatrix__context_cycle$",
        "hooks": [
          {
            "type": "command",
            "command": "unimatrix hook PreToolUse --provider codex-cli"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "unimatrix hook PostToolUse --provider codex-cli"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "unimatrix hook UserPromptSubmit --provider codex-cli"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "unimatrix hook SubagentStart --provider codex-cli"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "unimatrix hook PreCompact --provider codex-cli"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "unimatrix hook SessionStart --provider codex-cli"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "unimatrix hook Stop --provider codex-cli"
          }
        ]
      }
    ]
  }
}
