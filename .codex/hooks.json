{
  "description": "Unimatrix lifecycle observation for Codex. --provider codex-cli is required for correct source_domain attribution.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^context_cycle$|^mcp__unimatrix__context_cycle$",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/vscode/.unimatrix/dogfood-client/lib/hook-client/index.js PreToolUse --provider codex-cli"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/vscode/.unimatrix/dogfood-client/lib/hook-client/index.js PostToolUse --provider codex-cli"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/vscode/.unimatrix/dogfood-client/lib/hook-client/index.js UserPromptSubmit --provider codex-cli"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node /home/vscode/.unimatrix/dogfood-client/lib/hook-client/index.js SubagentStart --provider codex-cli"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/vscode/.unimatrix/dogfood-client/lib/hook-client/index.js PreCompact --provider codex-cli"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/vscode/.unimatrix/dogfood-client/lib/hook-client/index.js SessionStart --provider codex-cli"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /home/vscode/.unimatrix/dogfood-client/lib/hook-client/index.js Stop --provider codex-cli"
          }
        ]
      }
    ]
  }
}
